[Unit]
Description=Digital Signage Toolkit Auto Update
Documentation=https://github.com/b-piper/digital-signage-toolkit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/dst-toolkit/scripts/auto-update.sh
# Run as root for system-wide updates
User=root
# Prevent runaway processes
TimeoutStartSec=600
# Log to journal
StandardOutput=journal
StandardError=journal
