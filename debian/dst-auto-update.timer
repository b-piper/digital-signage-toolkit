[Unit]
Description=Digital Signage Toolkit Auto Update Check
Documentation=https://github.com/b-piper/digital-signage-toolkit

[Timer]
# Run daily at 3:00 AM with random delay up to 30 minutes
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=1800
# Ensure timer runs even if system was off at scheduled time
Persistent=true

[Install]
WantedBy=timers.target
